# ─── Special Care 360 Backend — Environment Variables ─────────────────────────
# Copy this file to .env and fill in your real values.

# CORS: comma-separated list of allowed frontend origins
# Example for local dev only:
ALLOWED_ORIGINS=http://localhost:3000
# Example for production (add your deployed URL):
# ALLOWED_ORIGINS=http://localhost:3000,https://special-care-360.vercel.app

# Firebase Admin SDK (optional — only needed if not using serviceAccountKey.json)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccountKey.json
