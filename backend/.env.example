# ─── Special Care 360 Backend — Environment Variables ─────────────────────────
# Copy this file to .env and fill in your real values.

# CORS: comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000
# Production example:
# ALLOWED_ORIGINS=http://localhost:3000,https://special-care-360.vercel.app

# Must match DEFAULT_CENTER_ID on the frontend (frontend/lib/auth-context.tsx).
DEFAULT_CENTER_ID=center-001

# Required by GET /ai-insights/abc/{student_id}. Without it that endpoint
# returns 500. https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ─── Panic alert email ────────────────────────────────────────────────────────
# Without these, POST /api/panic/alert still records the alert and notifies
# staff in-app; only the email is skipped.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
PANIC_ALERT_RECIPIENT_EMAIL=

# ─── Teletherapy video (8x8 JaaS) ─────────────────────────────────────────────
# Without these, GET /api/teletherapy/token returns 503 and the frontend falls
# back to the public meet.jit.si. That public instance will not start a
# conference until a moderator joins, and becoming one needs a Jitsi account —
# so configure this for anything beyond a click-through demo.
#
# From https://jaas.8x8.vc → API Keys:
#   JAAS_APP_ID      the tenant, looks like vpaas-magic-cookie-xxxxxxxx
#   JAAS_API_KEY_ID  the kid shown beside the key
#   JAAS_PRIVATE_KEY_PATH  path to the .pk file you downloaded
#
# The private key mints moderator tokens for the whole tenant. Keep it on the
# server, never in frontend/.env.local, and never commit it.
JAAS_APP_ID=
JAAS_API_KEY_ID=
JAAS_PRIVATE_KEY_PATH=
# Alternative to the path — the PEM inline, with \n for newlines:
# JAAS_PRIVATE_KEY=
# JAAS_DOMAIN=8x8.vc

# ─── Seed scripts ─────────────────────────────────────────────────────────────
# Used by create_parent.py, which no longer carries a hardcoded password.
SEED_PARENT_EMAIL=sara.ahmed@specialcare360.com
SEED_PARENT_PASSWORD=

# Firebase Admin SDK (optional — only needed if not using serviceAccountKey.json)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccountKey.json
