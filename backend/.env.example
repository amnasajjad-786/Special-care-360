# ─── Special Care 360 Backend — Environment Variables ─────────────────────────
# Copy this file to .env and fill in your real values.

# CORS: comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000
# Production example:
# ALLOWED_ORIGINS=http://localhost:3000,https://special-care-360.vercel.app

# Must match DEFAULT_CENTER_ID on the frontend (frontend/lib/auth-context.tsx).
DEFAULT_CENTER_ID=center-001

# Required by GET /ai-insights/abc/{student_id} and POST /ai-insights/iep/{student_id}.
# Without it those endpoints return 500. https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Required by POST /ai-insights/iep/{student_id} for structured goal generation.
COHERE_API_KEY=

# ─── Panic alert email ────────────────────────────────────────────────────────
# Without these, POST /api/panic/alert still records the alert and notifies
# staff in-app; only the email is skipped.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
PANIC_ALERT_RECIPIENT_EMAIL=

# ─── Teletherapy video (8x8 JaaS) ─────────────────────────────────────────────
# Select jitsi for free public demo rooms (host signs in on meet.jit.si).
# Anyone with a public meeting link can join. Use jaas for signed rooms.
TELETHERAPY_PROVIDER=jaas
# Without these, GET /api/teletherapy/token returns 503 and video calls are
# unavailable. Configure these credentials to enable signed private rooms.
#
# From https://jaas.8x8.vc → API Keys:
#   JAAS_APP_ID      the tenant, looks like vpaas-magic-cookie-xxxxxxxx
#   JAAS_API_KEY_ID  the kid shown beside the key
#   JAAS_PRIVATE_KEY_PATH  path to the .pk file you downloaded
#
# The private key mints moderator tokens for the whole tenant. Keep it on the
# server, never in frontend/.env.local, and never commit it.
JAAS_APP_ID=
JAAS_API_KEY_ID=
JAAS_PRIVATE_KEY_PATH=
# Alternative to the path — the PEM inline, with \n for newlines:
# JAAS_PRIVATE_KEY=
# JAAS_DOMAIN=8x8.vc

# ─── Seed scripts ─────────────────────────────────────────────────────────────
# Used by create_parent.py, which no longer carries a hardcoded password.
SEED_PARENT_EMAIL=sara.ahmed@specialcare360.com
SEED_PARENT_PASSWORD=

# Firebase Admin SDK (optional — only needed if not using serviceAccountKey.json)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccountKey.json

# ─── Private file storage (Firebase Storage) ──────────────────────────────────
# Used by progress videos and by student documents & reports. Requires the
# Blaze plan and Storage enabled in the Firebase console. storage.rules denies
# all browser access; only this API reads or writes, through the service
# account, and hands out five-minute signed links. Defaults to the project's
# default bucket <project-id>.firebasestorage.app.
FIREBASE_STORAGE_BUCKET=
PROGRESS_VIDEO_RETENTION_DAYS=30
# Progress-video transcripts and summaries need their own Gemini key; without
# it that feature returns 503 and the rest of the video workflow still works.
VIDEO_GEMINI_API_KEY=
# VIDEO_GEMINI_MODEL=gemini-3.8-flash
# Optional: ffmpeg/ffprobe binaries if not on PATH.
# FFMPEG_BIN=
# FFPROBE_BIN=

# ─── Background jobs ──────────────────────────────────────────────────────────
# How often (seconds) the API scans for appointment reminders (24h and 1h
# before teletherapy and therapy-timeline sessions) and missed medication.
APPOINTMENT_REMINDER_INTERVAL_SECONDS=300
MEDICATION_MONITOR_INTERVAL_SECONDS=60

# Local development only: lets the API boot against the mock store without
# serviceAccountKey.json. Never set this in production.
# ALLOW_LOCAL_MOCK=true

# ─── Online fee payment (Safepay) ─────────────────────────────────────────────
# Leave the keys empty to hide the "Pay online" button. Keys come from the
# Safepay merchant dashboard (Developers > API). Register the webhook URL
# <backend-url>/api/payments/safepay/webhook and paste its secret below.
SAFEPAY_ENVIRONMENT=sandbox
SAFEPAY_API_KEY=
SAFEPAY_SECRET_KEY=
SAFEPAY_WEBHOOK_SECRET=
SAFEPAY_CURRENCY=PKR
# Where Safepay sends the parent back after checkout.
FRONTEND_URL=http://localhost:3000
