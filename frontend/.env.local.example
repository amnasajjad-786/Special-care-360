# ─── Special Care 360 Frontend — Environment Variables ───────────────────────
# Copy to .env.local and fill in real values.
#
# These are REQUIRED: lib/firebase.ts initialises Firebase at module scope, so
# `npm run build` fails with auth/invalid-api-key if they are missing.
#
# Firebase Console → Project Settings → Your apps → Web app

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# FastAPI backend. Only the AI insights and panic fan-out endpoints are used.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional. Teletherapy video rooms. Defaults to the public meet.jit.si, which
# may ask the first participant to sign in before it will create a room — point
# this at a self-hosted or 8x8 instance to avoid that.
# NEXT_PUBLIC_JITSI_DOMAIN=meet.jit.si
