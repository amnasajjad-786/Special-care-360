rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function authenticated() { return request.auth != null; }
    function user() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function approved() { return authenticated() && user().status == 'approved' && user().uid == request.auth.uid; }
    function role(r) { return approved() && user().role == r; }
    function admin() { return role('admin'); }
    function staff() { return role('admin') || role('teacher') || role('therapist'); }
    function center(data) { return approved() && data.centerId == user().centerId; }
    function student(id) { return get(/databases/$(database)/documents/students/$(id)).data; }
    function visible(s) {
      return center(s) && (admin() ||
        (
          (role('parent') && s.parentId == request.auth.uid) ||
          (role('teacher') && s.teacherId == request.auth.uid) ||
          (role('therapist') && request.auth.uid in s.therapistIds)));
    }
    function child(id) { return id is string && visible(student(id)); }
    function activeChild(id) { return child(id) && !('archivedAt' in student(id)); }
    function record(data) { return (admin() && center(data)) || child(data.studentId); }
    function linked(data) {
      let s = student(data.studentId);
      return child(data.studentId) && !('archivedAt' in s) && data.centerId == s.centerId && data.parentId == s.parentId;
    }
    function unchangedLink() {
      return request.resource.data.studentId == resource.data.studentId
        && request.resource.data.centerId == resource.data.centerId
        && request.resource.data.parentId == resource.data.parentId;
    }
    function member(uid, r, cid) {
      let p = get(/databases/$(database)/documents/users/$(uid)).data;
      return uid is string && p.uid == uid && p.role == r && p.status == 'approved' && p.centerId == cid;
    }
    function assignments(s) {
      return member(s.parentId, 'parent', s.centerId)
        && (s.teacherId == '' || member(s.teacherId, 'teacher', s.centerId))
        && s.therapistIds is list && s.therapistIds.size() <= 4
        && (s.therapistIds.size() < 1 || member(s.therapistIds[0], 'therapist', s.centerId))
        && (s.therapistIds.size() < 2 || member(s.therapistIds[1], 'therapist', s.centerId))
        && (s.therapistIds.size() < 3 || member(s.therapistIds[2], 'therapist', s.centerId))
        && (s.therapistIds.size() < 4 || member(s.therapistIds[3], 'therapist', s.centerId));
    }
    function activityLink(data) {
      let a = get(/databases/$(database)/documents/homePlanActivities/$(data.activityId)).data;
      return linked(data) && a.studentId == data.studentId && a.centerId == data.centerId && a.parentId == data.parentId;
    }

    match /users/{uid} {
      allow read: if authenticated() && (request.auth.uid == uid || (admin() && center(resource.data)));
      allow create: if authenticated() && request.auth.uid == uid
        && request.resource.data.uid == uid && request.resource.data.status == 'pending'
        && request.resource.data.role in ['admin','teacher','therapist','parent']
        && exists(/databases/$(database)/documents/centers/$(request.resource.data.centerId));
      allow update: if request.resource.data.uid == uid && (
        (admin() && center(resource.data) && center(request.resource.data)) ||
        (authenticated() && request.auth.uid == uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','photoUrl'])));
      // Disabled profiles must survive: deleting them permits self-registration again.
      allow delete: if false;
    }
    match /centers/{id} {
      allow read: if authenticated();
      allow create, update: if admin() && id == user().centerId && center(request.resource.data);
      allow delete: if false;
    }
    match /students/{id} {
      allow read: if visible(resource.data);
      // getAfter makes enrollment atomic: the main document cannot exist alone.
      allow create: if admin() && center(request.resource.data) && assignments(request.resource.data)
        && getAfter(/databases/$(database)/documents/students/$(id)/medicalProfile/main).data.allergies is list
        && getAfter(/databases/$(database)/documents/students/$(id)/carePlan/main).data.goals == [];
      allow update: if admin() && center(resource.data) && center(request.resource.data)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['parentId','teacherId','therapistIds']) || assignments(request.resource.data));
      // Removal is an atomic archive. No client may cascade destructive deletes.
      allow delete: if false;
      match /medicalProfile/{docId} {
        allow read: if child(id);
        allow create: if (role('therapist') && activeChild(id)) ||
          (admin() && getAfter(/databases/$(database)/documents/students/$(id)).data.centerId == user().centerId);
        allow update: if (admin() || role('therapist')) && activeChild(id);
        allow delete: if false;
      }
      match /carePlan/{docId} {
        allow read: if child(id);
        allow create: if (role('therapist') && activeChild(id)) ||
          (admin() && !exists(/databases/$(database)/documents/students/$(id))
           && getAfter(/databases/$(database)/documents/students/$(id)).data.centerId == user().centerId
           && request.resource.data.keys().hasOnly(['goals']) && request.resource.data.goals == []);
        allow update: if role('therapist') && activeChild(id)
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['goals','achievedGoals'])
            || (request.resource.data.version is int && request.resource.data.version == resource.data.get('version', 0) + 1));
        allow delete: if false;
      }
      match /iepRecords/{docId} {
        allow read: if child(id);
        allow create, update: if role('therapist') && activeChild(id);
        allow delete: if false;
      }
      match /medicationAdministrations/{doseId} {
        allow read: if child(id);
        allow create, update: if (admin() || role('teacher')) && child(id)
          && linked(request.resource.data) && request.resource.data.studentId == id
          && request.resource.data.administeredBy == request.auth.uid
          && request.resource.data.status in ['administered','not_administered']
          && (request.resource.data.status == 'administered' || request.resource.data.notes.size() > 0)
          && (resource == null || (unchangedLink()
            && request.resource.data.medicationId == resource.data.medicationId
            && request.resource.data.date == resource.data.date
            && request.resource.data.scheduledTime == resource.data.scheduledTime));
        allow delete: if false;
      }
    }
    match /dailyCareJournals/{id} {
      allow read: if record(resource.data);
      allow create, update: if (admin() || role('teacher')) && linked(request.resource.data)
        && request.resource.data.submittedBy == request.auth.uid && (resource == null || unchangedLink());
      allow delete: if admin() && center(resource.data);
    }
    match /abcIncidents/{id} {
      allow read: if record(resource.data);
      allow create: if staff() && linked(request.resource.data) && request.resource.data.loggedBy == request.auth.uid;
      allow update: if admin() && linked(request.resource.data) && unchangedLink();
      allow delete: if admin() && center(resource.data);
    }
    match /panicAlerts/{id} {
      allow read: if record(resource.data);
      allow create: if staff() && linked(request.resource.data)
        && request.resource.data.id == id
        && request.resource.data.reportedBy.uid == request.auth.uid
        && request.resource.data.status == 'active' && request.resource.data.deliveryStatus == 'pending'
        && request.resource.data.keys().hasOnly(['id','studentId','centerId','parentId','reportedBy','emergencyType','description','location','timestamp','status','resolvedAt','resolvedBy','deliveryStatus']);
      allow update: if admin() && center(resource.data) && unchangedLink()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','resolvedAt','resolvedBy'])
        && request.resource.data.status == 'resolved' && request.resource.data.resolvedBy == request.auth.uid;
      allow delete: if false;
    }
    match /notifications/{id} {
      allow read: if approved() && resource.data.recipientId == request.auth.uid;
      allow create: if staff() && linked(request.resource.data)
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.type in ['daily_journal','behavior_incident','medical_update','care_plan_update','iep_finalized','teletherapy_session','home_plan_activity','therapy_session_scheduled','therapy_session_cancelled','therapy_session_rescheduled']
        && (request.resource.data.recipientId == student(request.resource.data.studentId).parentId
          || request.resource.data.recipientId == student(request.resource.data.studentId).teacherId
          || request.resource.data.recipientId in student(request.resource.data.studentId).therapistIds);
      allow update: if approved() && resource.data.recipientId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if approved() && resource.data.recipientId == request.auth.uid;
    }
    match /staff/{id} {
      allow read: if staff() && center(resource.data);
      allow create: if admin() && center(request.resource.data);
      allow update: if admin() && center(resource.data) && center(request.resource.data);
      allow delete: if false;
    }
    match /invoices/{id} {
      allow read: if (admin() && center(resource.data)) || (role('parent') && child(resource.data.studentId));
      allow create: if admin() && linked(request.resource.data);
      allow update: if admin() && linked(request.resource.data) && unchangedLink();
      allow delete: if false;
    }
    match /payments/{id} {
      allow read: if (admin() && center(resource.data)) || (role('parent') && child(resource.data.studentId));
      allow create: if admin() && linked(request.resource.data);
      allow update: if false;
      allow delete: if false;
    }
    match /teletherapySessions/{id} {
      allow read: if record(resource.data);
      allow create: if (admin() || role('therapist')) && linked(request.resource.data)
        && member(request.resource.data.therapistId, 'therapist', request.resource.data.centerId)
        && request.resource.data.therapistId in student(request.resource.data.studentId).therapistIds;
      allow update: if unchangedLink() && child(resource.data.studentId) && (
        ((admin() || role('therapist')) && request.resource.data.therapistId == resource.data.therapistId)
        || (role('parent') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['parentJoinedAt','updatedAt'])));
      allow delete: if false;
    }
    match /homePlanActivities/{id} {
      allow read: if record(resource.data);
      allow create: if (admin() || role('therapist')) && linked(request.resource.data) && request.resource.data.assignedBy == request.auth.uid;
      allow update: if (admin() || role('therapist')) && linked(request.resource.data) && unchangedLink();
      allow delete: if (admin() || role('therapist')) && child(resource.data.studentId);
    }
    match /homePlanLogs/{id} {
      allow read: if record(resource.data);
      allow create, update: if role('parent') && activityLink(request.resource.data) && (resource == null || unchangedLink());
      allow delete: if false;
    }
    match /homePlanMessages/{id} {
      allow read: if record(resource.data);
      allow create: if activityLink(request.resource.data) && request.resource.data.senderId == request.auth.uid && request.resource.data.senderRole == user().role;
      allow update, delete: if false;
    }
    // Alerts and observations are committed together by the authorized API.
    match /regressionAlerts/{id} {
      allow read: if staff() && center(resource.data) && record(resource.data);
      allow update: if (admin() || role('therapist')) && record(resource.data)
        && center(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resolved'])
        && request.resource.data.resolved == true;
      allow create, delete: if false;
    }
    match /milestoneObservations/{id} {
      allow read: if staff() && center(resource.data) && record(resource.data);
      allow create, update, delete: if false;
    }
    match /regressionState/{id} {
      allow read, write: if false;
    }
    // Timeline retains centre-wide staff scheduling and linked parent access.
    match /therapySessions/{sessionId} {
      allow read: if (staff() && center(resource.data)) || (role('parent') && center(resource.data) && resource.data.parentId == request.auth.uid);
      allow create: if staff() && linked(request.resource.data) && request.resource.data.createdBy == request.auth.uid;
      allow update: if center(resource.data) && linked(request.resource.data) && unchangedLink() && (admin() || (role('therapist') && (resource.data.therapistId == request.auth.uid || resource.data.createdBy == request.auth.uid)) || (role('teacher') && resource.data.createdBy == request.auth.uid));
      allow delete: if center(resource.data) && (admin() || (role('therapist') && (resource.data.therapistId == request.auth.uid || resource.data.createdBy == request.auth.uid)));
    }
  }
}
